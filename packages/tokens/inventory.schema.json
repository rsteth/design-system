{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App inventory v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "application",
    "reviewedRevision",
    "items",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "application": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "reviewedRevision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "source",
          "fixtures",
          "states",
          "coverage",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "component",
              "pattern",
              "screen",
              "domain",
              "external"
            ]
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:%?#\\u0000-\\u0020]+(?:/[^/\\\\:%?#\\u0000-\\u001f]+)*$"
            }
          },
          "fixtures": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverage": {
            "enum": [
              "covered",
              "partial",
              "excluded",
              "blocked"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "coverage": {
                  "const": "covered"
                },
                "kind": {
                  "enum": [
                    "component",
                    "pattern",
                    "screen"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "fixtures": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "coverage": {
                  "enum": [
                    "partial",
                    "excluded",
                    "blocked"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "notes": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "command",
          "status",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:%?#\\u0000-\\u0020]+(?:/[^/\\\\:%?#\\u0000-\\u001f]+)*$"
          }
        }
      }
    },
    "withheldRevisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Revision fields deliberately withheld from a public snapshot; authoritative local provenance is unchanged."
    }
  },
  "$comment": "Use validateInventory with collection for duplicate IDs and fixture referential integrity; CLI additionally verifies source/evidence files.",
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewedRevision": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "withheldRevisions"
        ],
        "properties": {
          "withheldRevisions": {
            "contains": {
              "const": "reviewedRevision"
            }
          }
        }
      }
    }
  ]
}
