{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsteth/design-system/schemas/tokens.schema.json",
  "title": "Design token contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "namespace",
    "modes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "selector",
          "tokens"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "tokens": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "color",
                    "dimension",
                    "fontFamily",
                    "number",
                    "string"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
