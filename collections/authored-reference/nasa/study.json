  "sections": [
    {
      "heading": "Current digital system",
      "text": "HDS Core documents a CSS theme on USWDS. Inter is used for headings, Public Sans for body text and DM Mono for technical labels. Its red and blue tokens distinguish navigation from on-page interaction. This study reads a pinned revision rather than installing HDS in Robin’s applications.",
      "line": 1
    },
    {
      "heading": "Historical print system",
      "text": "The January 1976 manual is retained as a source link, not combined with current digital tokens. Current brand guidance also distinguishes print typography from web typography.",
      "line": 2
    },
    {
      "heading": "Rights and exclusions",
      "text": "HDS code and tokens carry a CC0 dedication; font licenses and NASA marks are excluded. NASA brand guidance restricts insignia and logotype use. This study contains original neutral examples only and grants no right to reuse NASA identifiers.",
      "line": 3
    }
  ],
  "completeness": {
    "missingFields": [
      "complete component states",
      "responsive font interpolation",
      "motion",
      "screens"
    ],
    "tokenRoles": "Selected HDS values verified against a pinned first-party source; specimen layout is authored."
  },
  "limitations": [
    "Independent study, not an official NASA implementation or endorsement.",
    "Current digital HDS tokens are distinct from insignia colors and the historical 1976 print manual.",
    "No NASA insignia, worm, seal, mission identifiers, photography, screenshots or font binaries are reproduced.",
    "Font names and stacks are documented; samples use installed fonts/fallbacks, not guaranteed original rendering.",
    "Original sample compositions are not NASA production components. Responsive typography, complete states, motion and flagship CMS parity are not established."
  ]
}
